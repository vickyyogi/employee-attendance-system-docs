datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  COMPANY_ADMIN
  HR_ADMIN
  SUPERVISOR
  EMPLOYEE
  AUDITOR
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum PositionStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum SelfieUploadStatus {
  PENDING
  COMPLETED
  FAILED
  ATTACHED
  EXPIRED
}

enum AttendanceStatus {
  IN_PROGRESS
  PRESENT
  LATE
  FLAGGED
  CORRECTED
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  CORRECTION
  FLAG
}

enum LeaveUnit {
  DAYS
  HOURS
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalRequestType {
  LEAVE
  ATTENDANCE_CORRECTION
}

enum ApprovalActionType {
  APPROVED
  REJECTED
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String?     @map("password_hash")
  fullName     String      @map("full_name")
  phone        String?
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz

  memberships                  CompanyMembership[]
  platformAdmin                PlatformAdmin?
  refreshTokens                RefreshToken[]
  auditLogs                    AuditLog[]
  employees                    Employee[]
  selfieUploads                SelfieUpload[]
  attendanceEvents             AttendanceEvent[]
  decidedLeaveRequests         LeaveRequest[]                @relation("DecidedLeaveRequests")
  decidedAttendanceCorrections AttendanceCorrectionRequest[] @relation("DecidedAttendanceCorrections")
  approvalActions              ApprovalAction[]

  @@map("users")
}

model Company {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  slug      String        @unique
  timezone  String        @default("Asia/Jakarta")
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  memberships                  CompanyMembership[]
  departments                  Department[]
  positions                    Position[]
  auditLogs                    AuditLog[]
  employees                    Employee[]
  workLocations                WorkLocation[]
  shifts                       Shift[]
  employeeShifts               EmployeeShift[]
  holidays                     Holiday[]
  selfieUploads                SelfieUpload[]
  attendanceRecords            AttendanceRecord[]
  attendanceEvents             AttendanceEvent[]
  leaveTypes                   LeaveType[]
  leaveRequests                LeaveRequest[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  approvalActions              ApprovalAction[]

  @@map("companies")
}

model CompanyMembership {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole   @default(EMPLOYEE)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId, status])
  @@index([companyId, status])
  @@map("company_memberships")
}

model PlatformAdmin {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @unique @map("user_id") @db.Uuid
  status    PlatformAdminStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

model Department {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  name      String
  code      String?
  status    DepartmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("departments")
}

model Position {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  name      String
  status    PositionStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("positions")
}

model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  userId            String?          @map("user_id") @db.Uuid
  employeeNumber    String           @map("employee_number")
  fullName          String           @map("full_name")
  email             String?
  phone             String?
  departmentId      String?          @map("department_id") @db.Uuid
  positionId        String?          @map("position_id") @db.Uuid
  managerEmployeeId String?          @map("manager_employee_id") @db.Uuid
  employmentStatus  EmploymentStatus @default(ACTIVE) @map("employment_status")
  hireDate          DateTime?        @map("hire_date") @db.Date
  terminationDate   DateTime?        @map("termination_date") @db.Date
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position          Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager           Employee?        @relation("EmployeeToManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  subordinates      Employee[]       @relation("EmployeeToManager")
  employeeShifts               EmployeeShift[]
  selfieUploads                SelfieUpload[]
  attendanceRecords            AttendanceRecord[]
  leaveRequests                LeaveRequest[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]

  @@unique([companyId, employeeNumber])
  @@unique([companyId, userId])
  @@index([companyId, employmentStatus])
  @@index([companyId, departmentId])
  @@index([companyId, positionId])
  @@map("employees")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  requestId   String?   @map("request_id")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  metadata    Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model WorkLocation {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  name              String
  address           String?
  latitude          Decimal            @db.Decimal(10, 7)
  longitude         Decimal            @db.Decimal(10, 7)
  geofenceRadiusM   Int                @default(100) @map("geofence_radius_m")
  maxGpsAccuracyM   Int                @default(50) @map("max_gps_accuracy_m")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([companyId, isActive])
  @@map("work_locations")
}

model Shift {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  name               String
  startTimeLocal     String             @map("start_time_local")
  endTimeLocal       String             @map("end_time_local")
  crossesMidnight    Boolean            @default(false) @map("crosses_midnight")
  gracePeriodMinutes Int                @default(15) @map("grace_period_minutes")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeShifts     EmployeeShift[]
  attendanceRecords  AttendanceRecord[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("shifts")
}

model EmployeeShift {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, shiftId])
  @@map("employee_shifts")
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("holidays")
}

model SelfieUpload {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  employeeId         String?            @map("employee_id") @db.Uuid
  objectKey          String             @unique @map("object_key")
  originalName       String?            @map("original_name")
  mimeType           String             @map("mime_type")
  fileSizeBytes      Int?               @map("file_size_bytes")
  fileHashSha256     String?            @map("file_hash_sha256")
  status             SelfieUploadStatus @default(PENDING)
  uploadUrlExpiresAt DateTime           @map("upload_url_expires_at") @db.Timestamptz
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz
  metadata           Json?              @db.JsonB
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee           Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, status])
  @@index([companyId, status])
  @@index([uploadUrlExpiresAt, status])
  @@map("selfie_uploads")
}

model AttendanceRecord {
  id                      String           @id @default(uuid()) @db.Uuid
  companyId               String           @map("company_id") @db.Uuid
  employeeId              String           @map("employee_id") @db.Uuid
  workDate                DateTime         @map("work_date") @db.Date
  shiftId                 String?          @map("shift_id") @db.Uuid
  workLocationId          String?          @map("work_location_id") @db.Uuid
  checkInAt               DateTime?        @map("check_in_at") @db.Timestamptz
  checkOutAt              DateTime?        @map("check_out_at") @db.Timestamptz
  checkInLatitude         Decimal?         @map("check_in_latitude") @db.Decimal(10, 7)
  checkInLongitude        Decimal?         @map("check_in_longitude") @db.Decimal(10, 7)
  checkInAccuracyM        Int?             @map("check_in_accuracy_m")
  checkInDistanceM        Int?             @map("check_in_distance_m")
  checkInGeofenceValid    Boolean?         @map("check_in_geofence_valid")
  checkInSelfieObjectKey  String?          @map("check_in_selfie_object_key")
  checkOutLatitude        Decimal?         @map("check_out_latitude") @db.Decimal(10, 7)
  checkOutLongitude       Decimal?         @map("check_out_longitude") @db.Decimal(10, 7)
  checkOutAccuracyM       Int?             @map("check_out_accuracy_m")
  checkOutDistanceM       Int?             @map("check_out_distance_m")
  checkOutGeofenceValid   Boolean?         @map("check_out_geofence_valid")
  checkOutSelfieObjectKey String?          @map("check_out_selfie_object_key")
  status                  AttendanceStatus @default(IN_PROGRESS)
  idempotencyKey          String?          @map("idempotency_key")
  flagReason              String?          @map("flag_reason")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  company                 Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee                Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift                   Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  workLocation            WorkLocation?    @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  events                  AttendanceEvent[]
  correctionRequests      AttendanceCorrectionRequest[]

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@index([companyId, idempotencyKey])
  @@map("attendance_records")
}

model AttendanceEvent {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  attendanceRecordId String              @map("attendance_record_id") @db.Uuid
  eventType          AttendanceEventType @map("event_type")
  occurredAt         DateTime            @default(now()) @map("occurred_at") @db.Timestamptz
  actorUserId        String?             @map("actor_user_id") @db.Uuid
  metadata           Json?               @db.JsonB
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendanceRecord   AttendanceRecord    @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  actorUser          User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, attendanceRecordId])
  @@index([companyId, eventType])
  @@map("attendance_events")
}

model LeaveType {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  name             String
  unit             LeaveUnit      @default(DAYS)
  requiresApproval Boolean        @default(true) @map("requires_approval")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveRequests    LeaveRequest[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("leave_types")
}

model LeaveRequest {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  employeeId      String             @map("employee_id") @db.Uuid
  leaveTypeId     String             @map("leave_type_id") @db.Uuid
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  reason          String
  status          LeaveRequestStatus @default(PENDING)
  submittedAt     DateTime           @default(now()) @map("submitted_at") @db.Timestamptz
  decidedAt       DateTime?          @map("decided_at") @db.Timestamptz
  decidedByUserId String?            @map("decided_by_user_id") @db.Uuid
  decisionNote    String?            @map("decision_note")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  decidedByUser   User?              @relation("DecidedLeaveRequests", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId])
  @@index([companyId, status, submittedAt])
  @@index([companyId, startDate, endDate])
  @@map("leave_requests")
}

model AttendanceCorrectionRequest {
  id                  String                     @id @default(uuid()) @db.Uuid
  companyId           String                     @map("company_id") @db.Uuid
  employeeId          String                     @map("employee_id") @db.Uuid
  attendanceRecordId  String?                    @map("attendance_record_id") @db.Uuid
  requestedCheckInAt  DateTime?                  @map("requested_check_in_at") @db.Timestamptz
  requestedCheckOutAt DateTime?                  @map("requested_check_out_at") @db.Timestamptz
  reason              String
  status              AttendanceCorrectionStatus @default(PENDING)
  submittedAt         DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz
  decidedAt           DateTime?                  @map("decided_at") @db.Timestamptz
  decidedByUserId     String?                    @map("decided_by_user_id") @db.Uuid
  decisionNote        String?                    @map("decision_note")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee            Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecord    AttendanceRecord?          @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  decidedByUser       User?                      @relation("DecidedAttendanceCorrections", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId])
  @@index([companyId, status, submittedAt])
  @@map("attendance_correction_requests")
}

model ApprovalAction {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  requestType ApprovalRequestType @map("request_type")
  requestId   String              @map("request_id") @db.Uuid
  action      ApprovalActionType
  actorUserId String              @map("actor_user_id") @db.Uuid
  note        String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUser   User                @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([companyId, requestType, requestId])
  @@index([companyId, actorUserId, createdAt])
  @@map("approval_actions")
}



